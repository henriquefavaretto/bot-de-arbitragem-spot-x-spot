# ─── Binance ────────────────────────────────────────────────────────────────
# A API key precisa de: "Enable Spot & Margin Trading" + "Enable Withdrawals".
# Restrinja por IP e cadastre o endereço da carteira Polygon na whitelist de saque.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Par de compra e rede de saque (códigos da Binance)
BINANCE_SYMBOL=USDTBRL
BINANCE_WITHDRAW_COIN=USDT
BINANCE_WITHDRAW_NETWORK=MATIC

# ─── Carteira hot na Polygon ────────────────────────────────────────────────
# Chave privada da carteira que recebe o USDT, faz o swap e envia o BRLA.
# Use uma carteira DEDICADA, com apenas o capital de um ciclo.
POLYGON_PRIVATE_KEY=
# Um RPC dedicado (Alchemy/Infura/QuickNode) é fortemente recomendado:
# os públicos têm rate limit e caem sem aviso.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# ─── Rotas de saída ─────────────────────────────────────────────────────────
# Cada rota é um caminho BRL -> USDT -> stablecoin -> saque em BRL.
# Uma rota só fica habilitada se o endereço de destino estiver preenchido.
# O bot SÓ envia para estes endereços — qualquer outro é recusado.

# Rota 1: BRLA -> Picnic
PICNIC_DEPOSIT_ADDRESS=
PICNIC_WITHDRAW_FEE_BRL=0
PICNIC_WITHDRAW_FEE_PCT=0

# Rota 2: BRZ -> Chainless
CHAINLESS_DEPOSIT_ADDRESS=
CHAINLESS_WITHDRAW_FEE_BRL=0
CHAINLESS_WITHDRAW_FEE_PCT=0

# Rotas CEX -> CEX: saca USDT pela rede e vende USDT/BRL na exchange de destino.
#
# Escolha da rede — taxas de saque reais da Binance para USDT, cruzadas com as
# redes que Bitget e KuCoin aceitam depositar:
#
#   BEP20 (BSC)  0,010 USDT   ~3 min   <- melhor relação custo/tempo
#   PLASMA       0,012 USDT   ~1 min   chain nova, pouco rodada
#   AVAXC / OP   0,040 USDT   ~3 min
#   MATIC        0,070 USDT   ~10 min
#   ERC20        0,400 USDT   ~3 min
#   TON          0,300 USDT   ~3 min   EXIGE MEMO — sem ele o depósito se perde
#   TRC20        1,500 USDT   ~1 min   rápida, mas 150x mais cara que BEP20
#
# Em um ciclo de R$ 1.000, TRC20 custaria R$ 7,70 contra R$ 0,05 do BEP20 —
# 0,77 ponto percentual de spread jogado fora só na escolha da rede.

# Rota 3: Bitget
BITGET_DEPOSIT_ADDRESS=
BITGET_WITHDRAW_NETWORK=BSC
BITGET_SYMBOL=USDT/BRL
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSWORD=
BITGET_TAKER_FEE=0.001
BITGET_WITHDRAW_FEE_BRL=0
BITGET_WITHDRAW_FEE_PCT=0

# Rota 4: KuCoin (a API deles exige passphrase, como a Bitget)
KUCOIN_DEPOSIT_ADDRESS=
KUCOIN_WITHDRAW_NETWORK=BSC
KUCOIN_SYMBOL=USDT/BRL
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSWORD=
KUCOIN_TAKER_FEE=0.001
KUCOIN_WITHDRAW_FEE_BRL=0
KUCOIN_WITHDRAW_FEE_PCT=0

# Tokens na Polygon (padrões já verificados on-chain, mude só se precisar).
# Atenção ao BRZ: existe um contrato antigo de 4 decimais
# (0x491a4eB4f1FC3BfF8E1d2FC856a6A46663aD556f) já sem liquidez. Não use.
USDT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
BRLA_ADDRESS=0xE6A537a407488807F0bbeb0038B79004f19DdDfb
BRZ_ADDRESS=0x4eD141110F6EeeAbA9A1df36d8c26f684d2475Dc

# ─── Parâmetros de operação ─────────────────────────────────────────────────
# Valor em BRL gasto por ciclo
TRADE_AMOUNT_BRL=1000

# Spread líquido mínimo (%) para o modo automático disparar
MIN_SPREAD_PCT=0.5

# Teto de segurança: o bot recusa qualquer ciclo acima disso
MAX_TRADE_AMOUNT_BRL=5000

# Slippage no swap do KyberSwap, em basis points (50 = 0,5%)
SLIPPAGE_BPS=50

# Intervalo de atualização da cotação no dashboard (ms)
QUOTE_INTERVAL_MS=10000

# Taxa da Binance por ordem (taker). 0.001 = 0,1%
BINANCE_TAKER_FEE=0.001

# ─── Monitoramento (botão "Monitorar" na aba Malha) ─────────────────────────
# Aporte de referência das cotações gravadas. FIXO de propósito: spreads
# cotados com valores diferentes percorrem profundidades diferentes do livro,
# então uma base móvel tornaria dias diferentes incomparáveis entre si.
MONITOR_AMOUNT_BRL=1000
MONITOR_DIR=data/monitor
MONITOR_OPPORTUNITY_PCT=0.3

# Chaves SOMENTE LEITURA da OKX e da MEXC. Sem elas essas exchanges não
# expõem a taxa de saque, e as 12 pernas que saem delas ficam com estimativa
# conservadora de 1 USDT — o que as afunda artificialmente no ranking.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSWORD=
MEXC_API_KEY=
MEXC_API_SECRET=

# ─── Segurança ──────────────────────────────────────────────────────────────
# true = simula tudo (nenhuma ordem, saque ou tx real). Comece SEMPRE com true.
DRY_RUN=true

# Porta do dashboard e senha de acesso (deixe em branco para desabilitar login)
PORT=3000
DASHBOARD_PASSWORD=
