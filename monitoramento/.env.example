# ─── Operação simulada ──────────────────────────────────────────────────────
# Tamanho do aporte. Define quanta profundidade de livro é considerada:
# spreads calculados com R$ 1.000 e com R$ 50.000 são bem diferentes.
AMOUNT_BRL=1000

# Intervalo entre coletas, em ms
INTERVAL_MS=10000

# Spread líquido (%) a partir do qual a linha vai para oportunidades.csv
OPPORTUNITY_THRESHOLD_PCT=0.3

# Pasta dos CSVs
DATA_DIR=data

# ─── Taxas de negociação (fração: 0.001 = 0,1%) ─────────────────────────────
# Ajuste para o seu nível de VIP / desconto em cada exchange.
BINANCE_TAKER_FEE=0.001
OKX_TAKER_FEE=0.001
KUCOIN_TAKER_FEE=0.001
BITGET_TAKER_FEE=0.001
MEXC_TAKER_FEE=0.001

# ─── Taxas de saque de USDT (em USDT) ───────────────────────────────────────
# Cobradas pelo venue de ORIGEM ao enviar para outro. Variam por rede e mudam
# com frequência — confira na sua conta e ajuste. Estes são chutes conservadores.
BINANCE_WITHDRAW_FEE=0.1
OKX_WITHDRAW_FEE=0.1
KUCOIN_WITHDRAW_FEE=0.2
BITGET_WITHDRAW_FEE=0.1
MEXC_WITHDRAW_FEE=0.5

# ─── Polygon (rotas DEX) ────────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
GAS_SWAP_UNITS=400000
GAS_TRANSFER_UNITS=70000
KYBER_CLIENT_ID=monitor-spreads
